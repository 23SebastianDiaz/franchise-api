  "item": [
    {
      "name": "01 Create franchise",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/franchises",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "franchises"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Burger Co\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "pm.collectionVariables.set('franchiseId', j.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create branch (Centro)",
