{
  "info": {
    "name": "Franchise API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://6lgdtmkag3yjftcutdcwop4keq0mknuu.lambda-url.us-east-1.on.aws"
    },
    {
      "key": "franchiseId",
      "value": ""
    },
    {
      "key": "branchId",
      "value": ""
    },
    {
      "key": "branchId2",
      "value": ""
    },
