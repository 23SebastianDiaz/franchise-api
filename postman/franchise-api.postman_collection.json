      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const t = pm.response.json();",
              "pm.test('2 branches (empty one omitted)', () => pm.expect(t.length).to.eql(2));",
              "pm.test('Centro -> Fries (tie 60 vs Zeta, smaller name wins)', () => pm.expect(t.find(x=>x.branchName==='Centro').productName).to.eql('Fries'));",
              "pm.test('Norte -> Soda', () => pm.expect(t.find(x=>x.branchName==='Norte').productName).to.eql('Soda'));"
            ]
          }
        }
      ]
