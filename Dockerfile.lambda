# Same build as the main Dockerfile, plus the AWS Lambda Web Adapter extension.
# The adapter turns Lambda invocations into plain HTTP calls to the app on port 8080,
# so the Spring Boot code runs unchanged.

# ---- Stage 1: build the jar ----
FROM eclipse-temurin:21-jdk AS build
WORKDIR /workspace
COPY .mvn .mvn
COPY mvnw pom.xml ./
RUN ./mvnw -q -B dependency:go-offline
COPY src src
RUN ./mvnw -q -B -DskipTests package

# ---- Stage 2: Lambda runtime image ----
FROM eclipse-temurin:21-jre
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1 /lambda-adapter /opt/extensions/lambda-adapter

WORKDIR /app
COPY --from=build /workspace/target/*.jar app.jar

ENV PORT=8080 \
    AWS_LWA_READINESS_CHECK_PATH=/actuator/health \
    JAVA_TOOL_OPTIONS="-XX:+UseSerialGC -XX:TieredStopAtLevel=1"

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
